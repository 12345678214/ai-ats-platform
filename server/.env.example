# --- Server ---
NODE_ENV=development
PORT=4000
# Comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://ats:ats@localhost:5432/ats_dev?schema=public"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Python AI service ---
AI_SERVICE_URL=http://localhost:8000
# Must match AI_SERVICE_KEY in ai-service/.env
AI_SERVICE_KEY=dev-shared-service-key

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
